{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Debug Backend (Spring Boot)",
      "request": "launch",
      "mainClass": "com.parkandsee.backend.BackendApplication",
      "projectName": "backend",
      "args": "--spring.profiles.active=dev",
      "vmArgs": "-Dspring-boot.run.profiles=dev",
      "console": "integratedTerminal",
      "preLaunchTask": "Backend Dev (once)"
    },
    {
      "type": "chrome",
      "name": "Debug Frontend (Chrome)",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend-react/src",
      "sourceMaps": true,
      "preLaunchTask": "Frontend Dev (Vite)"
    },
    {
      "type": "msedge",
      "name": "Debug Frontend (Edge)",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend-react/src",
      "sourceMaps": true,
      "preLaunchTask": "Frontend Dev (Vite)"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Dev Full Stack (Backend + Frontend)",
      "configurations": [],
      "preLaunchTask": "Dev Full Stack (Backend + Frontend)",
      "presentation": {
        "hidden": false,
        "group": "dev",
        "order": 1
      },
      "stopAll": true
    }
  ]
}